#!/usr/bin/env bash
# ── Sketchybar — Catppuccin-themed, aerospace-aware, notch-safe ──
# Font: JetBrainsMono Nerd Font (family name, no extra spaces)
# Icon reference: https://www.nerdfonts.com/cheat-sheet

CONFIG_DIR="$HOME/.config/sketchybar"
source "$CONFIG_DIR/plugins/colors.sh"

sketchybar --bar \
  height=30 \
  padding_left=6 \
  padding_right=6 \
  y_offset=4 \
  blur_radius=0 \
  position=top \
  margin=3 \
  corner_radius=16 \
  color="$BAR_COLOR" \
  shadow=off \
  border_width=0

# ── Global defaults ─────────────────────────────────────────────
FONT="JetBrainsMono Nerd Font"

sketchybar --default \
  updates=when_shown \
  icon.font="$FONT:Bold:13.0" \
  label.font="$FONT:Bold:11.0" \
  icon.color="$TEXT" \
  label.color="$TEXT" \
  background.corner_radius=12 \
  background.height=24 \
  background.padding_left=1 \
  background.padding_right=1 \
  icon.padding_left=8 \
  icon.padding_right=3 \
  label.padding_left=3 \
  label.padding_right=8


# ── Theme switching ────────────────────────────────────────────
sketchybar --add event theme_change AppleInterfaceThemeChangedNotification
sketchybar --add item theme_handler left \
  --subscribe theme_handler theme_change \
  --set theme_handler \
    drawing=off \
    label.drawing=off \
    icon.drawing=off \
    script="sleep 1 && pkill -x sketchybar"
sketchybar --add event aerospace_workspace_change

# ── LEFT: Workspaces (dynamic, aerospace-driven) ────────────────

for sid in $(aerospace list-workspaces --all 2>/dev/null); do
  sketchybar --add item "space.$sid" left \
    --subscribe "space.$sid" aerospace_workspace_change \
    --set "space.$sid" \
      drawing=off \
      icon="$sid" \
      icon.padding_left=10 \
      icon.padding_right=10 \
      background.drawing=on \
      background.color="$SURFACE0" \
      label.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

sketchybar --add item ws_controller left \
  --subscribe ws_controller aerospace_workspace_change \
  --set ws_controller \
    drawing=off \
    label.drawing=off \
    icon.drawing=off \
    script="$CONFIG_DIR/plugins/update_workspaces.sh"

# ── RIGHT: Widgets (ordered right to left) ──────────────────────
# Pill colors: surface0 = interactive/clickable, surface1 = display-only

# Clock (display-only, non-interactive)
sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    background.drawing=on \
    background.color="$SURFACE0" \
    icon.drawing=off \
    icon.padding_left=0 \
    icon.padding_right=0 \
    label.padding_left=10 \
    label.padding_right=10 \
    script="$CONFIG_DIR/plugins/clock.sh"

# Date (display-only, non-interactive)
sketchybar --add item date right \
  --set date \
    update_freq=60 \
    background.drawing=on \
    background.color="$SURFACE0" \
    icon.drawing=off \
    icon.padding_left=0 \
    icon.padding_right=0 \
    label.padding_left=10 \
    label.padding_right=10 \
    script="$CONFIG_DIR/plugins/date.sh"

# Battery (non-interactive)
sketchybar --add item battery right \
  --subscribe battery system_woke power_source_change \
  --set battery \
    update_freq=30 \
    background.drawing=on \
    background.color="$SURFACE0" \
    icon.padding_left=8 \
    icon.padding_right=4 \
    label.padding_left=4 \
    label.padding_right=10 \
    script="$CONFIG_DIR/plugins/battery.sh"

# Spotify (interactive — click to open)
sketchybar --add item spotify right \
  --subscribe spotify media_change \
  --set spotify \
    update_freq=5 \
    background.drawing=on \
    background.color="$TEAL" \
    icon="" \
    icon.color="$BAR_COLOR" \
    label.color="$BAR_COLOR" \
    icon.padding_left=8 \
    icon.padding_right=4 \
    label.padding_right=10 \
    label.padding_left=4 \
    click_script="open -a Spotify" \
    script="$CONFIG_DIR/plugins/spotify.sh"

# Memory pressure graph (non-interactive)
sketchybar --add graph mem_pressure right 60 \
  --set mem_pressure \
    graph.color="$MAUVE" \
    graph.line_width=2 \
    background.drawing=off \
    label.drawing=off \
    padding_left=4 \
    padding_right=16 \
    script="$CONFIG_DIR/plugins/mem_pressure.sh" \
    update_freq=3
# ── Finalize ────────────────────────────────────────────────────
sketchybar --update
echo "sketchybar loaded — Catppuccin $(is_dark && echo Mocha || echo Latte)"

# Hide native menu bar after items are ready
osascript -e 'tell application "System Events" to tell dock preferences to set autohide menu bar to true' 2>/dev/null || true
