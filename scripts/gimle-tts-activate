#!/usr/bin/env python3
"""Operator-only TTS persistence after pinned adoption. Default is read-only."""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import time
from datetime import datetime, timezone

BASE = Path('/nix/store/afawa8n5l2rn23g2383hm31v34nn70x8-darwin-system-26.11.57abbd5')
TARGET = Path('/nix/store/l9j2c81nsm1ggg46h8k0bfay6lr0mnd2-darwin-system-26.11.57abbd5')
TARGET_SHA = '5daddc215c2bde9ebfd01e8515beae9a65efb3e03c1ff3481fc8a5474880222d'
BASE_SHA = '682ca3582d25d1761b2902254028db1f08d56174936beeec291be1cab81a44a8'
RUNNER = Path('/nix/store/nrh90pywrxc32gqwyd1xldg9ga471540-loki-service-run')
CURRENT = Path('/run/current-system')
PROFILE = Path('/nix/var/nix/profiles/system')
NIX_ENV = '/nix/var/nix/profiles/default/bin/nix-env'
PROTECTED = ('ask', 'browser', 'gateway', 'hue', 'tailscaled', 'vault', 'volume')
RECOVERY = Path('/Users/gimle/loki-data/recovery')
LEGACY_PID = 43544


def run(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True).stdout


def listeners(port):
    p = subprocess.run(['/usr/sbin/lsof', '-nP', '-t', '-iTCP:' + str(port), '-sTCP:LISTEN'], capture_output=True, text=True)
    if p.returncode not in (0, 1):
        raise ValueError('Cannot inspect listener')
    return sorted(set(p.stdout.split())) if p.returncode == 0 else []


def processes():
    result = {}
    for name in PROTECTED:
        output = run('/bin/launchctl', 'print', 'system/dk.loki.' + name)
        match = re.search(r'^\s*pid = (\d+)$', output, re.M)
        if not match and name != 'volume':
            raise ValueError('Protected service not running: ' + name)
        result[name] = int(match.group(1)) if match else None
    result['chrome9377'], result['chrome9444'] = listeners(9377), listeners(9444)
    return result


def tunnel_command():
    loader = importlib.machinery.SourceFileLoader('verified_tts_runner', str(RUNNER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module.auxiliary_command('tts-tunnel')


def validate():
    if socket.gethostname() != 'gimle' or not Path('/Users/gimle/loki-data').is_mount():
        raise ValueError('Requires Gimle encrypted mount')
    if CURRENT.resolve() != BASE or PROFILE.resolve() != BASE or Path('/etc/static').resolve() != (BASE / 'etc').resolve():
        raise ValueError('Finish and verify the pinned adoption first; no TTS action performed')
    for generation, digest in ((BASE, BASE_SHA), (TARGET, TARGET_SHA)):
        if hashlib.sha256((generation / 'activate').read_bytes()).hexdigest() != digest:
            raise ValueError('Reviewed generation changed')
    for name in PROTECTED + ('muninn-backup',):
        filename = 'dk.loki.' + name + '.plist'
        candidate = (TARGET / 'Library/LaunchDaemons' / filename).read_bytes()
        if candidate != (BASE / 'Library/LaunchDaemons' / filename).read_bytes():
            raise ValueError('Protected candidate differs: ' + name)
        if candidate != (Path('/Library/LaunchDaemons') / filename).read_bytes():
            raise ValueError('Protected live plist differs: ' + name)
    if Path('/Library/LaunchDaemons/dk.loki.tts-tunnel.plist').exists() or Path('/etc/loki/auxiliary-enabled').exists():
        raise ValueError('Existing TTS management; inspect before replacement')
    if listeners(9500) != [str(LEGACY_PID)]:
        raise ValueError('Unexpected TTS listener; no signal sent')
    command = run('/bin/ps', '-ww', '-p', str(LEGACY_PID), '-o', 'command=').strip()
    if run('/bin/ps', '-p', str(LEGACY_PID), '-o', 'uid=').strip() != '501':
        raise ValueError('TTS process owner changed')
    if not command.startswith('/usr/bin/ssh ') or '127.0.0.1:9500:127.0.0.1:5000' not in command:
        raise ValueError('Unexpected legacy process; no signal sent')
    tunnel_command()  # Validate existing encrypted private transport before stop.
    return processes()


def activate(generation, log):
    # The RunAtLoad boot-activation job reads this profile during activation.
    # Set it FIRST (standard nix-darwin ordering), never after activation.
    expected = BASE_SHA if generation == BASE else TARGET_SHA
    if hashlib.sha256((generation / 'activate').read_bytes()).hexdigest() != expected:
        raise ValueError('Activation changed immediately before execution')
    subprocess.run([NIX_ENV, '-p', str(PROFILE), '--set', str(generation)], check=True)
    previous_umask = os.umask(0o022)
    try:
        with log.open('w') as output:
            subprocess.run([str(generation / 'sw/bin/darwin-rebuild'), 'activate'],
                           check=True, stdout=output, stderr=subprocess.STDOUT)
    finally:
        os.umask(previous_umask)
    log.chmod(0o600)
    if CURRENT.resolve() != generation or PROFILE.resolve() != generation or Path('/etc/static').resolve() != (generation / 'etc').resolve():
        raise RuntimeError('Running generation, profile and managed etc disagree')


def restore_tunnel():
    if listeners(9500):
        raise ValueError('Port occupied; refusing legacy replacement')
    command = tunnel_command()
    # Background only the explicitly restored legacy tunnel; daemon uses -N.
    subprocess.run(['/usr/bin/sudo', '-u', 'gimle', '--', command[0], '-f', *command[1:]], check=True)
    if not listeners(9500):
        raise RuntimeError('Legacy tunnel restoration did not listen')


def main():
    if sys.argv[1:] not in ([], ['--apply']):
        raise SystemExit('Usage: gimle-tts-activate [--apply]')
    before = validate()
    print(json.dumps({'protected': before, 'stop_only': LEGACY_PID, 'target': str(TARGET)}, indent=2), flush=True)
    if not sys.argv[1:]:
        print('TTS READ-ONLY PREFLIGHT PASS')
        return
    if os.geteuid() != 0:
        raise SystemExit('Operator sudo required; no mutation')
    os.umask(0o077)
    state = RECOVERY / ('tts-operator-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ'))
    state.mkdir(mode=0o700)
    (state / 'before.json').write_text(json.dumps(before, indent=2))
    stopped = False
    try:
        if listeners(9500) != [str(LEGACY_PID)]:
            raise ValueError('TTS changed after preflight')
        os.kill(LEGACY_PID, 15)
        stopped = True
        for _ in range(50):
            if not listeners(9500):
                break
            time.sleep(0.1)
        if listeners(9500):
            raise RuntimeError('Port did not become free')
        activate(TARGET, state / 'activation.log')
        for _ in range(30):
            if listeners(9500):
                break
            time.sleep(1)
        output = run('/bin/launchctl', 'print', 'system/dk.loki.tts-tunnel')
        match = re.search(r'^\s*pid = (\d+)$', output, re.M)
        if not match or listeners(9500) != [match.group(1)]:
            raise RuntimeError('Managed TTS not listening')
        after = processes()
        (state / 'after.json').write_text(json.dumps(after, indent=2))
        if before != after:
            raise RuntimeError('Protected process changed; inspect recorded evidence')
        print('TTS MANAGED HANDOFF PASS; existing services/Chrome unchanged. Consumer synthesis still required.')
    except Exception as exc:
        (state / 'failure.json').write_text(json.dumps({'error': str(exc), 'current': str(CURRENT.resolve()), 'profile': str(PROFILE.resolve())}, indent=2))
        if stopped:
            # BASE is the adoption generation and retains the backup job. Never
            # roll back to the pre-adoption system that predates that job.
            if CURRENT.resolve() == TARGET or PROFILE.resolve() == TARGET or Path('/etc/static').resolve() != (BASE / 'etc').resolve():
                activate(BASE, state / 'rollback.log')
            else:
                subprocess.run(['/bin/launchctl', 'bootout', 'system/dk.loki.tts-tunnel'], capture_output=True)
            if listeners(9500) != [str(LEGACY_PID)]:
                restore_tunnel()
            print('Recovered legacy TTS; persistence not accepted. Inspect ' + str(state), file=sys.stderr)
        raise


if __name__ == '__main__':
    main()
