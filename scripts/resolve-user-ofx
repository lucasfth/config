#!/usr/bin/env python3
"""Opt-in macOS Resolve launch with user and system OFX discovery; no global env."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

APP = Path('/Applications/DaVinci Resolve/DaVinci Resolve.app')


def ofx_path(home, existing):
    # Empty path elements can mean the working directory; do not introduce them.
    paths = [str(home / 'Library/OFX/Plugins'), *existing.split(':'), '/Library/OFX/Plugins']
    return ':'.join(dict.fromkeys(path for path in paths if path))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--print-command', action='store_true', help='preview JSON argv without launching')
    args = parser.parse_args(argv)
    home = Path.home()
    if not home.is_absolute() or ':' in str(home):
        raise ValueError('HOME must be absolute and contain no OFX path separator (:)')
    command = ['/usr/bin/open', '-a', str(APP), '--env',
               'OFX_PLUGIN_PATH=' + ofx_path(home, os.environ.get('OFX_PLUGIN_PATH', ''))]
    if args.print_command:
        print(json.dumps(command))
        return
    # Never use open -n: another instance risks project databases. open cannot
    # retrofit environment into an existing app, so do not imply that it can.
    status = subprocess.run(['/usr/bin/pgrep', '-x', 'Resolve'], stdout=subprocess.DEVNULL).returncode
    if status != 1:
        raise RuntimeError('Resolve is running (or process check failed). Quit it manually before using this launcher; no environment changed.')
    if not (APP / 'Contents/MacOS/Resolve').is_file():
        raise ValueError(f'Resolve executable not found in {APP}')
    subprocess.run(command, check=True)
    print('Launch requested with user OFX path; confirm discovery in Resolve. No global environment changed.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
