#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
"""Open Sigyn in macOS Screen Sharing through a temporary SSH tunnel."""

import socket
import subprocess
import sys
import time


def available_port() -> int:
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return probe.getsockname()[1]


def wait_for_tunnel(tunnel: subprocess.Popen, port: int) -> None:
    deadline = time.monotonic() + 12
    while time.monotonic() < deadline:
        status = tunnel.poll()
        if status is not None:
            raise RuntimeError(f"SSH tunnel failed to start (exit {status})")
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.1):
                return
        except OSError:
            time.sleep(0.05)
    raise TimeoutError("SSH tunnel did not become ready within 12 seconds")


def stop_tunnel(tunnel: subprocess.Popen) -> None:
    if tunnel.poll() is not None:
        return
    tunnel.terminate()
    try:
        tunnel.wait(timeout=5)
    except subprocess.TimeoutExpired:
        tunnel.kill()
        tunnel.wait()


def main() -> int:
    port = available_port()
    tunnel = subprocess.Popen([
        "ssh", "-N", "-T",
        "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=yes",
        "-o", "ConnectTimeout=10",
        "-o", "ExitOnForwardFailure=yes",
        "-L", f"127.0.0.1:{port}:127.0.0.1:5901",
        "sigyn",
    ])
    try:
        wait_for_tunnel(tunnel, port)
        return subprocess.run([
            "open", "-W", "-n", f"vnc://127.0.0.1:{port}",
        ]).returncode
    finally:
        stop_tunnel(tunnel)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, TimeoutError) as error:
        print(f"sigyn-screen: {error}", file=sys.stderr)
        raise SystemExit(1)
