#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["vncdotool==1.4.2", "cryptography<48"]
# ///
"""Wake, unlock, and open Sigyn in macOS Screen Sharing over SSH."""

import os
import plistlib
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from vncdotool import api


LOCAL_PORT = 5901
KEYCHAIN_SERVER = f"127.0.0.1:{LOCAL_PORT}"
KEYCHAIN_PROTOCOL = "vnc "
SCREEN_SHARING = (
    "/System/Applications/Utilities/Screen Sharing.app/Contents/MacOS/Screen Sharing"
)
MANAGED_PREFERENCES = "/var/jb/Library/PreferenceBundles/TrollVNCPrefs.bundle/Managed.plist"
SSH_OPTIONS = (
    "-o", "BatchMode=yes",
    "-o", "StrictHostKeyChecking=yes",
    "-o", "ConnectTimeout=10",
)


def refresh_vnc_password() -> str:
    result = subprocess.run(
        ["ssh", *SSH_OPTIONS, "sigyn", "cat", MANAGED_PREFERENCES],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"could not read Sigyn's managed TrollVNC credential (SSH exit {result.returncode})"
        )
    try:
        preferences = plistlib.loads(result.stdout)
    except plistlib.InvalidFileException as error:
        raise RuntimeError("Sigyn's managed TrollVNC preferences are not a valid plist") from error
    password = preferences.get("FullPassword")
    if not isinstance(password, str) or len(password) < 8:
        raise RuntimeError("Sigyn's managed TrollVNC credential is missing or shorter than 8 characters")

    password_path = Path.home() / ".config/sigyn/vnc-password"
    cached = password_path.read_text().strip() if password_path.exists() else None
    if cached != password:
        password_path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
        descriptor, temporary_path = tempfile.mkstemp(
            prefix=".vnc-password.", dir=password_path.parent
        )
        try:
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, "w") as stream:
                stream.write(password + "\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary_path, password_path)
        finally:
            try:
                os.unlink(temporary_path)
            except FileNotFoundError:
                pass
    return password[:8]


def ensure_keychain_password(password: str) -> None:
    identity = [
        "-a", "",
        "-s", KEYCHAIN_SERVER,
        "-r", KEYCHAIN_PROTOCOL,
    ]

    result = subprocess.run(
        [
            "security", "add-internet-password", *identity,
            "-l", "Sigyn VNC",
            "-T", SCREEN_SHARING,
            "-U",
            "-w",
        ],
        input=f"{password}\n{password}\n",
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    if result.returncode != 0:
        print(
            "sigyn-screen: warning: could not store the VNC password in macOS Keychain",
            file=sys.stderr,
        )

def unlock_sigyn(port: int, password: str) -> None:
    try:
        client = api.connect(
            f"127.0.0.1::{port}",
            password=password,
            timeout=20,
        )
        try:
            client.refreshScreen()
            width, height = client.screen.size

            client.mouseDown(3)
            time.sleep(0.12)
            client.mouseUp(3)
            time.sleep(2)

            x = width // 2
            start_y = round(height * 15 / 16)
            end_y = round(height * 95 / 288)
            client.mouseMove(x, start_y)
            client.mouseDown(1)
            time.sleep(0.3)
            for step in range(1, 25):
                client.mouseMove(x, round(start_y + (end_y - start_y) * step / 24))
                time.sleep(0.05)
            client.mouseUp(1)
            time.sleep(2)
        finally:
            client.disconnect()
    except Exception as error:
        raise RuntimeError(f"could not unlock Sigyn: {error}") from error


def wait_for_tunnel(tunnel: subprocess.Popen, port: int) -> None:
    deadline = time.monotonic() + 12
    while time.monotonic() < deadline:
        status = tunnel.poll()
        if status is not None:
            raise RuntimeError(f"SSH tunnel failed to start (exit {status})")
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.1):
                return
        except OSError:
            time.sleep(0.05)
    raise TimeoutError("SSH tunnel did not become ready within 12 seconds")


def stop_tunnel(tunnel: subprocess.Popen) -> None:
    if tunnel.poll() is not None:
        return
    tunnel.terminate()
    try:
        tunnel.wait(timeout=5)
    except subprocess.TimeoutExpired:
        tunnel.kill()
        tunnel.wait()


def main() -> int:
    password = refresh_vnc_password()
    ensure_keychain_password(password)
    port = LOCAL_PORT
    tunnel = subprocess.Popen([
        "ssh", "-N", "-T", *SSH_OPTIONS,
        "-o", "ExitOnForwardFailure=yes",
        "-L", f"127.0.0.1:{port}:127.0.0.1:5901",
        "sigyn",
    ])
    try:
        wait_for_tunnel(tunnel, port)
        unlock_sigyn(port, password)
        return subprocess.run([
            "open", "-W", "-n", f"vnc://VNC@127.0.0.1:{port}",
        ]).returncode
    finally:
        stop_tunnel(tunnel)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, TimeoutError) as error:
        print(f"sigyn-screen: {error}", file=sys.stderr)
        raise SystemExit(1)
