#!/usr/bin/env python3
"""Run one native Loki service only after its encrypted home is available."""
import os
from pathlib import Path
import json
import re
import socket
import stat
import sys

VOLUME = Path('/Users/gimle/loki-data')
LIVE = VOLUME / 'live'
HOME = LIVE / 'hermes'
SOURCE = LIVE / 'hermes-source'
SERVICES = {
    'gateway': None,
    'vault': 'mcp-vault-server/server.py',
    'ask': 'mcp-ask-loki/server.py',
    'browser': 'mcp-browser-server/server.py',
    'hue': 'mcp-hue-server/server.py',
    'chrome-browser': None,
    'tts-tunnel': None,
}
TTS_TRANSPORT = LIVE / 'tts-transport.json'


def auxiliary_command(service):
    if service == 'chrome-browser':
        return [
            '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
            '--headless=new', '--remote-debugging-address=127.0.0.1',
            '--remote-debugging-port=9377',
            f'--user-data-dir={HOME / "browser-profile"}',
            '--no-first-run', '--no-default-browser-check', '--disable-gpu', 'about:blank',
        ]
    assert service == 'tts-tunnel', 'Unknown auxiliary service'
    assert not TTS_TRANSPORT.is_symlink(), 'Unsafe TTS transport'
    info = TTS_TRANSPORT.stat()
    assert info.st_uid == 501 and stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o600, 'Unsafe TTS transport'
    host = json.loads(TTS_TRANSPORT.read_text())['host']
    assert isinstance(host, str) and re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.-]*@[A-Za-z0-9][A-Za-z0-9.-]*', host), 'Invalid TTS host'
    return [
        '/usr/bin/ssh', '-N', '-T', '-o', 'BatchMode=yes',
        '-o', 'StrictHostKeyChecking=yes', '-o', 'UpdateHostKeys=no',
        '-o', 'IdentitiesOnly=yes', '-o', 'ExitOnForwardFailure=yes',
        '-o', 'ConnectTimeout=10', '-o', 'ServerAliveInterval=30',
        '-o', 'ServerAliveCountMax=3', '-i', '/Users/gimle/.ssh/id_ed25519',
        '-L', '127.0.0.1:9500:127.0.0.1:5000', host,
    ]


def main():
    assert os.geteuid() == 501 and socket.gethostname() == 'gimle', 'Must run as gimle on Gimle'
    assert os.environ.get('HOME') == '/Users/gimle', 'Wrong service HOME'
    assert len(sys.argv) == 2 and sys.argv[1] in SERVICES, 'Unknown service'
    service = sys.argv[1]
    assert VOLUME.is_mount() and not VOLUME.is_symlink(), 'Encrypted volume not mounted'
    assert VOLUME.stat().st_uid == 501 and stat.S_IMODE(VOLUME.stat().st_mode) == 0o700
    assert (LIVE / 'preparation.json').is_file(), 'Native runtime not prepared'
    auxiliary = service in ('chrome-browser', 'tts-tunnel')
    gate_name = 'auxiliary' if auxiliary else 'production'
    gate = Path(f'/etc/loki/{gate_name}-enabled')
    # /etc files are root-managed symlinks into the Nix store.
    assert gate.is_file(), f'{gate_name.title()} has not been enabled'
    assert gate.resolve().is_relative_to(Path('/nix/store')), 'Unmanaged service gate'
    assert gate.stat().st_uid == 0 and not gate.stat().st_mode & 0o022, 'Unsafe service gate'
    if auxiliary:
        command = auxiliary_command(service)
        os.execv(command[0], command)
        return
    if service == 'vault':
        node = HOME / 'tools/node-26.7.0-darwin-arm64/bin/node'
        assert node.is_file(), 'Native managed Node missing'
        os.environ['READ_CODE_NODE'] = str(node)
    os.environ['HERMES_HOME'] = str(HOME)
    os.environ['HERMES_RUNTIME_DIR'] = str(HOME / 'tools')
    os.environ['VAULT_PATH'] = str(VOLUME / 'loki-memory')
    os.environ['VAULT_INDEX_DB'] = str(HOME / 'mcp-vault-server/index.db')
    os.environ['MUNINN_TEMPORAL_DB'] = str(HOME / 'mcp-vault-server/temporal.db')
    os.environ['MUNINN_MCP_TOKENS'] = str(HOME / 'mcp-vault-server/tokens.json')
    assert Path(os.environ['MUNINN_MCP_TOKENS']).is_file(), 'Caller authentication file missing'
    tool_bins = []
    for directory in sorted((HOME / 'tools').iterdir()):
        if directory.is_dir():
            tool_bins.extend(str(p) for p in [directory / 'bin', directory] if p.is_dir())
    os.environ['PATH'] = ':'.join([
        '/Users/gimle/.nix-profile/bin', '/opt/homebrew/bin', '/Users/gimle/.local/bin',
        *tool_bins, '/usr/bin', '/bin', '/usr/sbin', '/sbin',
    ])
    os.chdir(SOURCE)
    python = HOME / 'tools/python-3.14.7+20260901-darwin-arm64/bin/python3'
    assert python.is_file(), 'Native managed Python missing'
    # Resolve the managed dependency closure at process start, not at deployment.
    bootstrap = (
        'import sys,runpy;'
        f'sys.path.insert(0,{str(SOURCE)!r});'
        'import hermes_bootstrap;'
        f'sys.path.insert(0,{str(LIVE / "service-vendor")!r});'
        'from dotenv import load_dotenv;'
        f'load_dotenv({str(HOME / ".env")!r},override=False);'
    )
    if service == 'ask':
        # Ask Loki must not race the API socket at startup. A TCP check doesn't
        # invoke an API, submit an agent turn, or deliver any message.
        with socket.create_connection(('127.0.0.1', 8642), timeout=3):
            pass
    if service == 'gateway':
        ready = json.loads((LIVE / 'cutover-ready.json').read_text())
        assert ready.get('phone_writers_stopped') is True, 'Phone writer stop not recorded'
        assert ready.get('final_snapshot_verified') is True, 'Final snapshot not verified'
    if service == 'gateway':
        bootstrap += "runpy.run_module('hermes_cli.main',run_name='__main__',alter_sys=True)"
        args = ['gateway', 'run']  # Never --replace; duplicate polling must fail closed.
    else:
        target = HOME / SERVICES[service]
        bootstrap += f'sys.path.insert(0,{str(target.parent)!r});runpy.run_path({str(target)!r},run_name="__main__")'
        args = []
    os.execv(str(python), [str(python), '-I', '-c', bootstrap, *args])


if __name__ == '__main__':
    main()
