#!/usr/bin/env python3
"""Idempotently unlock Gimle's encrypted image without exposing its root-only key."""
import os
from pathlib import Path
import plistlib
import pwd
import socket
import stat
import subprocess

BASE = Path('/Library/Application Support/Loki')
IMAGE = BASE / 'LokiData.sparsebundle'
KEY = BASE / 'volume.key'
MOUNT = Path('/Users/gimle/loki-data')
HDIUTIL = '/usr/bin/hdiutil'


def verify_mount():
    info = plistlib.loads(subprocess.check_output([HDIUTIL, 'info', '-plist']))
    matches = [image for image in info.get('images', [])
               if Path(image.get('image-path', '')).resolve() == IMAGE.resolve()]
    assert len(matches) == 1, 'Expected Loki image is not attached'
    assert any(entity.get('mount-point') == str(MOUNT)
               for entity in matches[0].get('system-entities', [])), 'Wrong image at Loki mountpoint'
    account = pwd.getpwnam('gimle')
    assert MOUNT.stat().st_uid == account.pw_uid, 'Wrong volume owner'
    assert stat.S_IMODE(MOUNT.stat().st_mode) == 0o700, 'Unsafe volume permissions'


def main():
    assert os.geteuid() == 0 and socket.gethostname() == 'gimle', 'Root on Gimle required'
    for path, mode in [(BASE, 0o700), (KEY, 0o600)]:
        meta = path.lstat()
        assert not stat.S_ISLNK(meta.st_mode), 'Symlink in private storage path'
        assert meta.st_uid == 0 and stat.S_IMODE(meta.st_mode) == mode, 'Unsafe key ownership or mode'
    assert IMAGE.is_dir() and not IMAGE.is_symlink(), 'Expected disk image missing'
    assert MOUNT.is_dir() and not MOUNT.is_symlink(), 'Expected mountpoint missing'
    if not MOUNT.is_mount():
        assert not any(MOUNT.iterdir()), 'Refuse to hide files beneath mountpoint'
        encrypted = plistlib.loads(subprocess.check_output([HDIUTIL, 'isencrypted', str(IMAGE), '-plist']))
        assert encrypted.get('encrypted') is True, 'Refuse unencrypted image'
        subprocess.run([HDIUTIL, 'attach', str(IMAGE), '-stdinpass', '-mountpoint', str(MOUNT),
                        '-nobrowse', '-owners', 'on'], input=KEY.read_bytes(), check=True,
                       stdout=subprocess.DEVNULL)
    verify_mount()
    print('Loki encrypted volume ready')


if __name__ == '__main__':
    main()
