#!/bin/sh
# Keep the signed DMG intact until the macOS-native copy step.
set -eu
image=$1
plugin_dir=${2:-/Library/OFX/Plugins}
helper=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/install-gyroflow-ofx
codesign --verify -R '=anchor apple generic and certificate leaf[subject.OU] = "RR3ZC2L4DF"' "$image"
spctl --assess --type open --context context:primary-signature "$image"
work=$(mktemp -d)
mounted=0
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ "$mounted" = 1 ]; then
    hdiutil detach "$work/mount" || status=1
  fi
  rmdir "$work/mount" 2>/dev/null || true
  rmdir "$work"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
mkdir "$work/mount"
hdiutil attach -readonly -nobrowse -mountpoint "$work/mount" "$image"
mounted=1
/bin/sh "$helper" "$work/mount/Gyroflow.ofx.bundle" "$plugin_dir"
