#!/usr/bin/env python3
"""Install next-boot gateway/dashboard plists without loading or restarting jobs.

Payload is generated from evaluated Nix configuration and reviewed runner source.
Dry-run by default. Existing plists are backed up for rollback; no credentials,
auto-login settings, current processes, or Tailscale state are modified.
"""
import argparse
import json
import os
from pathlib import Path
import plistlib
import socket
import stat
import subprocess
import tempfile
import time

ROOT = Path('/Library/LaunchDaemons')
LABELS = ('dk.loki.gateway', 'dk.loki.dashboard')


def validate(job, label):
    assert job['Label'] == label and job['UserName'] == 'gimle'
    assert job['RunAtLoad'] is True and job['KeepAlive'] == {'SuccessfulExit': False}
    args = job['ProgramArguments']
    assert args[:2] == ['/bin/sh', '-c'] and 'exit 75' in args[2]
    assert args[4].startswith('/nix/store/') and args[4].endswith('/bin/python3')
    assert args[5] == '-c', 'Runner must be embedded, not a writable file dependency'
    compile(args[6], '<boot-runner>', 'exec')
    if label == 'dk.loki.gateway':
        assert args[7:] == ['gateway']
        assert 'hermes-loki-v0.22.6' in args[6] and 'phone_writers_stopped' in args[6]
    else:
        assert 'dashboard-server.sh' in args[6] and 'production-enabled' in args[6]
    data = plistlib.dumps(job)
    with tempfile.NamedTemporaryFile(suffix='.plist') as check:
        check.write(data)
        check.flush()
        subprocess.run(['/usr/bin/plutil', '-lint', check.name], capture_output=True, check=True)
    return data


def atomic_write(path, data):
    fd, tmp = tempfile.mkstemp(prefix='.loki-next-boot-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchmod(stream.fileno(), 0o644)
            os.fchown(stream.fileno(), 0, 0)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('payload', type=Path)
    parser.add_argument('--apply', action='store_true')
    args = parser.parse_args()
    assert socket.gethostname() == 'gimle', 'Run on Gimle only'
    if args.apply:
        assert os.geteuid() == 0, 'sudo required for --apply'
    jobs = json.loads(args.payload.read_text())
    assert set(jobs) == set(LABELS), 'Unexpected job scope'
    planned = {}
    for label in LABELS:
        path = ROOT / (label + '.plist')
        data = validate(jobs[label], label)
        original = None
        if path.exists() or path.is_symlink():
            meta = path.lstat()
            assert stat.S_ISREG(meta.st_mode) and meta.st_uid == 0 and not meta.st_mode & 0o022
            original = path.read_bytes()
            existing = plistlib.loads(original)
            assert existing['Label'] == label and existing['UserName'] == 'gimle'
            if label == 'dk.loki.gateway':
                # Preserve environment, working directory, retry and log policy.
                assert {k:v for k,v in existing.items() if k != 'ProgramArguments'} == {k:v for k,v in jobs[label].items() if k != 'ProgramArguments'}
        elif label == 'dk.loki.gateway':
            raise AssertionError('Existing gateway unit required')
        if original != data:
            planned[path] = (original, data)
        print(label, 'install next-boot plist' if original != data else 'already installed')
    if not args.apply:
        print('DRY RUN: no changes. Apply never runs launchctl or restarts a process.')
        return
    if not planned:
        print('No changes required.')
        return
    backup = Path(tempfile.mkdtemp(prefix=time.strftime('loki-next-boot-%Y%m%d-%H%M%S-'), dir='/var/root'))
    for path, (original, _) in planned.items():
        if original is not None:
            (backup / path.name).write_bytes(original)
        else:
            (backup / (path.name + '.absent')).touch()
    print('Rollback directory:', backup, flush=True)
    changed = []
    try:
        for path, (original, data) in planned.items():
            assert not path.is_symlink()
            assert (path.read_bytes() if path.exists() else None) == original, 'Concurrent change'
            atomic_write(path, data)
            changed.append(path)
            assert path.read_bytes() == data, 'Readback mismatch'
    except Exception:
        for path in reversed(changed):
            original = planned[path][0]
            if original is None:
                path.unlink()
            else:
                atomic_write(path, original)
        raise
    print('Installed and read back next-boot plists. Running sessions unchanged.')
    print('Rollback before reboot: restore saved .plist files; remove only units marked .absent.')


if __name__ == '__main__':
    main()
