#!/usr/bin/env python3
"""Start the existing authenticated dashboard only on the encrypted Loki home."""
import os
from pathlib import Path
import socket
import stat

VOLUME = Path('/Users/gimle/loki-data')
GATE = Path('/etc/loki/production-enabled')
RUNNER = VOLUME / 'live/hermes/bin/dashboard-server.sh'


def main():
    assert os.geteuid() == 501 and socket.gethostname() == 'gimle', 'Must run as gimle on Gimle'
    assert os.environ.get('HOME') == '/Users/gimle', 'Wrong service HOME'
    assert VOLUME.is_mount() and not VOLUME.is_symlink(), 'Encrypted volume not mounted'
    info = VOLUME.stat()
    assert info.st_uid == 501 and stat.S_IMODE(info.st_mode) == 0o700, 'Unsafe encrypted home'
    assert GATE.is_file(), 'Production not enabled'
    assert GATE.resolve().is_relative_to(Path('/nix/store')), 'Unmanaged production gate'
    info = GATE.stat()
    assert info.st_uid == 0 and not info.st_mode & 0o022, 'Unsafe production gate'
    assert RUNNER.is_file(), 'Existing dashboard wrapper missing'
    # Preserve its selected runtime, binding and authentication. Never open a
    # browser or create a replacement home when storage/network is unavailable.
    os.execv('/bin/bash', ['/bin/bash', str(RUNNER)])


if __name__ == '__main__':
    main()
