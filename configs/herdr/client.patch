+pub(super) fn render_machine_header(
+    buffer: &mut Buffer, rect: Rect, row: &AgentRow, config: &ClientShellConfig,
+) -> Rect {
+    let Some(machine) = row.machine_header.as_deref().filter(|_| rect.height > 1) else {
+        return rect;
+    };
+    let title = crate::ui::truncate_end(machine, rect.width.saturating_sub(5) as usize);
+    let prefix = format!(" ── {title} ");
+    let line = format!("{prefix}{}", "─".repeat((rect.width as usize).saturating_sub(display_width(&prefix))));
+    Paragraph::new(line).style(Style::default().fg(config.palette.overlay0))
+        .render(Rect::new(rect.x, rect.y, rect.width, 1), buffer);
+    Rect::new(rect.x, rect.y + 1, rect.width, rect.height - 1)
+}
+
+fn render_product_row(buffer: &mut Buffer, rect: Rect, row: &AgentRow, config: &ClientShellConfig) {
+    use crate::api::schema::AgentStatus;
+    use ratatui::text::Span;
+    if rect.is_empty() { return; }
+    let palette = &config.palette;
+    let color = if row.stale { palette.overlay0 } else { match row.status {
+        AgentStatus::Working => palette.blue,
+        AgentStatus::Blocked => palette.yellow,
+        AgentStatus::Done => palette.green,
+        AgentStatus::Idle | AgentStatus::Unknown => palette.overlay0,
+    }};
+    let mut icon_style = Style::default().fg(color);
+    let mut title_style = Style::default().fg(if row.stale { palette.overlay0 } else { match row.status {
+        AgentStatus::Blocked => palette.yellow,
+        AgentStatus::Working => palette.text,
+        _ => palette.subtext0,
+    }});
+    if row.stale || row.status == AgentStatus::Unknown {
+        icon_style = icon_style.add_modifier(Modifier::DIM);
+        title_style = title_style.add_modifier(Modifier::DIM);
+    } else if row.status == AgentStatus::Blocked {
+        title_style = title_style.add_modifier(Modifier::BOLD);
+    }
+    let prefix = format!(" {} ", row.icon);
+    let label = if row.stale { "stale" } else { &row.status_label };
+    let width = rect.width as usize;
+    let available = width.saturating_sub(display_width(&prefix));
+    // Keep the icon and its explicit separating space even at narrow widths.
+    let show_status = available >= display_width(label) + 2;
+    let title_width = available.saturating_sub(if show_status { display_width(label) + 1 } else { 0 });
+    let title = crate::ui::truncate_end(&row.title, title_width);
+    let mut spans = vec![Span::styled(prefix, icon_style), Span::styled(title.clone(), title_style)];
+    if show_status {
+        spans.push(Span::raw(" ".repeat(available.saturating_sub(display_width(&title) + display_width(label)))));
+        spans.push(Span::styled(label.to_owned(), icon_style));
     }
+    let style = if row.focused { Style::default().bg(palette.active_row_bg) } else { Style::default() };
+    Paragraph::new(Line::from(spans)).style(style).render(Rect::new(rect.x, rect.y, rect.width, 1), buffer);
 }
