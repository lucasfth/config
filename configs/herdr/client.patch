+#[test]
+fn leading_metrics_keep_worktree_connector_on_name_row() {
+    use crate::config::SpaceSidebarToken;
+    let mut config = Config::default();
+    config.ui.sidebar.spaces.rows = vec![
+        vec![SpaceSidebarToken::Custom("host_load".into())],
+        vec![SpaceSidebarToken::StateIcon, SpaceSidebarToken::Workspace],
+    ];
+    let mut projected = snapshot();
+    projected.workspaces[0].worktree = Some(ClientShellWorktree {
+        key: "repo".into(), label: "repo".into(), is_linked_worktree: false,
+    });
+    projected.workspaces[0].tokens = vec![("host_load".into(), "parent metrics".into())];
+    let mut child = projected.workspaces[0].clone();
+    child.workspace_id = "ws_2".into();
+    child.branch = Some("feature".into());
+    child.worktree.as_mut().unwrap().is_linked_worktree = true;
+    child.tokens = vec![("host_load".into(), "metrics".into())];
+    projected.workspaces.push(child);
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    let frame = state.compose(106, 30).expect("grouped stats-first sidebar");
+    let rect = state.hits.workspaces[1].rect;
+    let name = cell_symbol_position(&frame, rect, "feature");
+    let connector = cell_symbol_position(&frame, rect, "└─");
+    let metrics = cell_symbol_position(&frame, rect, "metrics");
+    let parent = state.hits.workspaces[0].rect;
+    let parent_name = cell_symbol_position(&frame, parent, "client-shell");
+    let toggle = state.hits.workspaces[0].group_toggle.as_ref().expect("parent toggle").0;
+    assert_eq!(toggle.y, parent_name.1, "collapse control belongs to the title");
+    assert_eq!(connector.1, name.1, "tree marker belongs to the workspace title");
+    assert!(metrics.1 < name.1);
+}
