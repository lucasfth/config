+    assert!(cell_symbol_position(&frame, fourth, "\u{f2db}").1 < gamma.1);
+
+    let mut renderer = crate::client::state::ClientState::test_new();
+    let mut output = Vec::new();
+    assert!(renderer.try_present_frame_to(&mut output, frame.clone()));
+    let mut terminal = crate::ghostty::Terminal::new(frame.width, frame.height, 0).unwrap();
+    terminal.write(&output);
+
+    let terminal_name_column = |name: &str, y: u16| {
+        let characters = name.chars().map(u32::from).collect::<Vec<_>>();
+        (0..frame.width.saturating_sub(characters.len() as u16))
+            .find(|start| {
+                characters.iter().enumerate().all(|(offset, character)| {
+                    terminal
+                        .screen_cell(start + offset as u16, u32::from(y))
+                        .is_ok_and(|(_, graphemes)| {
+                            graphemes.len() == 1 && graphemes[0] == *character
+                        })
+                })
+            })
+            .unwrap_or_else(|| panic!("{name:?} missing from terminal row {y}"))
+    };
+    let terminal_alpha = terminal_name_column("alpha", alpha.1);
+    let terminal_beta = terminal_name_column("beta", beta.1);
+    let terminal_config = terminal_name_column("config", config_name.1);
+    let terminal_gamma = terminal_name_column("gamma", gamma.1);
+    assert_eq!(terminal_alpha, terminal_beta, "ANSI output must preserve local workspace alignment");
+    assert_eq!(terminal_alpha, terminal_config, "ANSI output must preserve local workspace alignment");
+    assert_eq!(terminal_alpha, terminal_gamma, "ANSI output must preserve cross-endpoint alignment");
+
+    for y in 0..frame.height {
+        let mut row = String::new();
+        terminal
+            .for_each_screen_row_cell(u32::from(y), |wide, graphemes| {
+                if wide == crate::ghostty::CellWide::SpacerTail {
+                    return;
+                }
+                if graphemes.is_empty() {
+                    row.push(' ');
+                } else {
+                    row.extend(graphemes.iter().filter_map(|codepoint| char::from_u32(*codepoint)));
+                }
+            })
+            .unwrap();
+        println!("{row}");
+    }
+}
