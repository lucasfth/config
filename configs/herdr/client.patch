+fn product_status_styles_labels_stale_focus_and_narrow_unicode_rendering() {
+    let config = ClientShellConfig::from_config(&Config::default());
+    for (status, input, stale, label, color, dim) in [
+        (AgentStatus::Working, false, false, "working", config.palette.blue, false),
+        (AgentStatus::Blocked, true, false, "input", config.palette.yellow, false),
+        (AgentStatus::Blocked, false, false, "blocked", config.palette.yellow, false),
+        (AgentStatus::Done, false, false, "done", config.palette.green, false),
+        (AgentStatus::Idle, false, false, "idle", config.palette.overlay0, false),
+        (AgentStatus::Unknown, false, false, "unknown", config.palette.overlay0, true),
+        (AgentStatus::Working, false, true, "stale", config.palette.overlay0, true),
+        (AgentStatus::Blocked, true, true, "stale", config.palette.overlay0, true),
+    ] {
+        let mut projected = snapshot();
+        let mut entry = agent("fallback", status, 1);
+        entry.title = Some("審査 e\u{301} very long session title".into());
+        entry.tokens = vec![("needs_input".into(), input.to_string())];
+        projected.agents = vec![entry];
+        let mut row = super::super::agent_sidebar::agent_row(&projected, "pane_1", &config, None).unwrap();
+        row.stale = stale;
+        for focused in [false, true] {
+            row.focused = focused;
+            for width in [1, 2, 3, 4, 12, 26, 60] {
+                let rect = Rect::new(0, 0, width, 1);
+                let mut buffer = Buffer::empty(rect);
+                super::super::agent_sidebar::render_agent_row(&mut buffer, rect, &row, &config);
+                let text: String = (0..width).map(|x| buffer[(x, 0)].symbol()).collect();
+                if width >= 12 { assert!(text.ends_with(label), "{width} {text:?}"); }
+                if width >= 4 { assert!(text.starts_with(" π "), "{text}"); }
+                if width > 1 {
+                    let cell = &buffer[(1, 0)];
+                    assert_eq!(cell.fg, color);
+                    assert_eq!(cell.modifier.contains(Modifier::DIM), dim);
+                    if focused { assert_eq!(cell.bg, config.palette.active_row_bg); }
+                }
+                if width == 60 {
+                    let title = &buffer[(3, 0)];
+                    assert_eq!(title.modifier.contains(Modifier::BOLD), status == AgentStatus::Blocked && !stale);
+                    assert_eq!(title.modifier.contains(Modifier::DIM), dim);
+                }
+            }
+        }
+    }
+}
