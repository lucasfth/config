 use super::*;
 
+#[test]
+fn workspace_names_align_after_leading_host_metrics() {
+    use crate::config::SpaceSidebarToken;
+
+    let mut config = Config::default();
+    config.ui.sidebar.spaces.rows = vec![
+        vec![SpaceSidebarToken::Custom("host_load".into())],
+        vec![SpaceSidebarToken::Custom("host_storage".into())],
+        vec![SpaceSidebarToken::StateIcon, SpaceSidebarToken::Workspace],
+        vec![SpaceSidebarToken::Branch],
+    ];
+    let mut projected = snapshot();
+    projected.workspaces[0].label = "alpha".into();
+    projected.workspaces[0].tokens = vec![
+        ("host_load".into(), "\u{f2db} 30% \u{efc5} 7.4G".into()),
+        ("host_storage".into(), "\u{f0a0} 288G ⎓ 80%".into()),
+    ];
+    let mut second = projected.workspaces[0].clone();
+    second.workspace_id = "ws_2".into();
+    second.label = "beta".into();
+    second.tokens.clear();
+    second.focused = false;
+    projected.workspaces.push(second);
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    let frame = state.compose(106, 30).expect("stats-first sidebar");
+    let first = state.hits.workspaces[0].rect;
+    let second = state.hits.workspaces[1].rect;
+    let alpha = cell_symbol_position(&frame, first, "alpha");
+    let beta = cell_symbol_position(&frame, second, "beta");
+    assert_eq!(alpha.0, beta.0, "workspace names must share a column");
+    let cpu = cell_symbol_position(&frame, first, "\u{f2db}");
+    let memory = cell_symbol_position(&frame, first, "\u{efc5}");
+    let disk = cell_symbol_position(&frame, first, "\u{f0a0}");
+    assert!(cpu.1 < disk.1 && disk.1 < alpha.1);
+    assert_eq!(cpu.0, disk.0, "host summary rows must align");
+    assert!(memory.0 > cpu.0, "Nerd Font memory glyph must survive rendering");
+}
