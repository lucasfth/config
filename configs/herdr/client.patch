+    state.config.agent_panel_sort = crate::config::AgentPanelSortConfig::Priority;
+    let frame = state.compose(120, 60).unwrap();
+    let body = state.hits.agent_body;
+    let text = frame.cells.chunks(frame.width as usize).skip(body.y as usize)
+        .take(body.height as usize).map(|line| line.iter().take(body.width as usize)
+            .map(|cell| cell.symbol.as_str()).collect::<String>()).collect::<Vec<_>>().join("\n");
+    assert!(!text.contains("── Same machine name"));
