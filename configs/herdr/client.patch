+#[test]
+fn stats_first_machine_sidebar_keeps_workspace_names_aligned() {
+    use crate::config::SpaceSidebarToken;
+    let (mut state, remote) = state_with_remote();
+    let mut config = Config::default();
+    config.ui.sidebar.spaces.rows = vec![
+        vec![SpaceSidebarToken::Custom("host_load".into())],
+        vec![SpaceSidebarToken::Custom("host_storage".into())],
+        vec![SpaceSidebarToken::StateIcon, SpaceSidebarToken::Workspace],
+    ];
+    state.config = ClientShellConfig::from_config(&config);
+
+    let mut local = snapshot();
+    local.workspaces[0].label = "alpha".into();
+    local.workspaces[0].agent_status = crate::api::schema::AgentStatus::Unknown;
+    local.workspaces[0].tokens = vec![
+        ("host_load".into(), "\u{f2db} 30% \u{efc5} 7.4G".into()),
+        ("host_storage".into(), "\u{f0a0} 288G ⎓ 80%".into()),
+    ];
+    let mut second = local.workspaces[0].clone();
+    second.workspace_id = "ws_2".into();
+    second.label = "beta".into();
+    second.tokens.clear();
+    second.focused = false;
+    local.workspaces.push(second);
+    let mut third = local.workspaces[0].clone();
+    third.workspace_id = "ws_3".into();
+    third.number = 3;
+    third.label = "config".into();
+    third.tokens.clear();
+    third.agent_status = crate::api::schema::AgentStatus::Working;
+    third.focused = false;
+    local.workspaces.push(third);
+    state.set_snapshot(Box::new(local));
+
+    let mut remote_snapshot = snapshot();
+    remote_snapshot.boot_id = "remote-boot".into();
+    remote_snapshot.workspaces[0].label = "gamma".into();
+    remote_snapshot.workspaces[0].agent_status = crate::api::schema::AgentStatus::Unknown;
+    remote_snapshot.workspaces[0].tokens = vec![
+        ("host_load".into(), "\u{f2db} 6% \u{efc5} 3.1G".into()),
+        ("host_storage".into(), "\u{f0a0} 390G".into()),
+    ];
+    state.set_endpoint_snapshot(&remote, Box::new(remote_snapshot));
+
+    let frame = state.compose(106, 38).expect("two-machine sidebar");
+    let first = state.hits.workspaces[0].rect;
+    let second = state.hits.workspaces[1].rect;
+    let third = state.hits.workspaces[2].rect;
+    let fourth = state.hits.workspaces[3].rect;
+    let alpha = cell_symbol_position(&frame, first, "alpha");
+    let beta = cell_symbol_position(&frame, second, "beta");
+    let config_name = cell_symbol_position(&frame, third, "config");
+    let gamma = cell_symbol_position(&frame, fourth, "gamma");
+    assert_eq!(alpha.0, beta.0);
+    assert_eq!(alpha.0, config_name.0);
+    assert_eq!(alpha.0, gamma.0);
+    assert!(cell_symbol_position(&frame, first, "\u{f2db}").1 < alpha.1);
+    assert!(cell_symbol_position(&frame, fourth, "\u{f2db}").1 < gamma.1);
+
+    let mut renderer = crate::client::state::ClientState::test_new();
+    let mut output = Vec::new();
+    assert!(renderer.try_present_frame_to(&mut output, frame.clone()));
+    let mut terminal = crate::ghostty::Terminal::new(frame.width, frame.height, 0).unwrap();
+    terminal.write(&output);
+
+    let terminal_name_column = |name: &str, y: u16| {
+        let characters = name.chars().map(u32::from).collect::<Vec<_>>();
+        (0..frame.width.saturating_sub(characters.len() as u16))
+            .find(|start| {
+                characters.iter().enumerate().all(|(offset, character)| {
+                    terminal
+                        .screen_cell(start + offset as u16, u32::from(y))
+                        .is_ok_and(|(_, graphemes)| {
+                            graphemes.len() == 1 && graphemes[0] == *character
+                        })
+                })
+            })
+            .unwrap_or_else(|| panic!("{name:?} missing from terminal row {y}"))
+    };
+    let terminal_alpha = terminal_name_column("alpha", alpha.1);
+    let terminal_beta = terminal_name_column("beta", beta.1);
+    let terminal_config = terminal_name_column("config", config_name.1);
+    let terminal_gamma = terminal_name_column("gamma", gamma.1);
+    assert_eq!(terminal_alpha, terminal_beta, "ANSI output must preserve local workspace alignment");
+    assert_eq!(terminal_alpha, terminal_config, "ANSI output must preserve local workspace alignment");
+    assert_eq!(terminal_alpha, terminal_gamma, "ANSI output must preserve cross-endpoint alignment");
+
+    for y in 0..frame.height {
+        let mut row = String::new();
+        terminal
+            .for_each_screen_row_cell(u32::from(y), |wide, graphemes| {
+                if wide == crate::ghostty::CellWide::SpacerTail {
+                    return;
+                }
+                if graphemes.is_empty() {
+                    row.push(' ');
+                } else {
+                    row.extend(graphemes.iter().filter_map(|codepoint| char::from_u32(*codepoint)));
+                }
+            })
+            .unwrap();
+        println!("{row}");
+    }
+}
