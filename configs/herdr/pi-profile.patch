+// Discover Huginn's existing hook without changing stock Pi install/uninstall paths
+// or OMP's directory. Explicit overrides and an installed stock hook win.
+fn pi_status_path() -> io::Result<PathBuf> {
+    let standard = pi_extension_dir()?.join(super::PI_EXTENSION_INSTALL_NAME);
+    if std::env::var_os(PI_CODING_AGENT_DIR_ENV_VAR).is_some_and(|value| !value.is_empty())
+        || standard.is_file()
+    {
+        return Ok(standard);
+    }
+    let huginn = home_dir()?
+        .join(".local/share/huginn-pi/agent/extensions")
+        .join(super::PI_EXTENSION_INSTALL_NAME);
+    Ok(if huginn.is_file() { huginn } else { standard })
+}
