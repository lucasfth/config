# Visually mask recognised secrets; keep Nerd Font icons. This is not redaction.
font-family = Obel Mono
font-family = JetBrainsMono Nerd Font
font-codepoint-map = U+E000-U+F8FF,U+F0000-U+FFFFD,U+100000-U+10FFFD=JetBrainsMono Nerd Font
font-feature = ss01

theme = Catppuccin Mocha
keybind = global:shift+alt+cmd+n=toggle_quick_terminal
window-decoration = true
macos-titlebar-style = hidden
window-padding-x = 5
window-padding-y = 5
split-divider-color = #fefefe
unfocused-split-fill = #6c7086

keybind = ctrl+n=new_window

# Send word-delete explicitly without changing Danish Option-character input.
keybind = alt+backspace=text:\x1b\x7f

keybind = shift+cmd+f=toggle_split_zoom

keybind = shift+cmd+h=resize_split:left,10
keybind = shift+cmd+l=resize_split:right,10
keybind = shift+cmd+j=resize_split:down,10
keybind = shift+cmd+k=resize_split:up,10

keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab

window-save-state = always

# Keep Hyper+A as Herdr's Ctrl+B prefix; intercept the a/i submenus.
keybind = super+alt+ctrl+shift+a=activate_key_table_once:herdr-prefix
keybind = chain=text:\x02
keybind = ctrl+b=activate_key_table_once:herdr-prefix
keybind = chain=text:\x02
# Explicit Escape avoids merging with the next shortcut's leading Ctrl+B.
keybind = herdr-prefix/a=text:\x1b[27u
keybind = chain=activate_key_table:herdr-agents
keybind = herdr-prefix/i=text:\x1b[27u
keybind = chain=activate_key_table_once:herdr-shell
keybind = herdr-prefix/unconsumed:catch_all=end_key_sequence

# Persistent agent-only navigation. Do not forward navigation keys to panes.
keybind = herdr-agents/j=text:\x02\x1b[106;5u
keybind = herdr-agents/k=text:\x02\x1b[107;5u
keybind = herdr-agents/physical:one=text:\x02\x1b[49;7u
keybind = herdr-agents/physical:two=text:\x02\x1b[50;7u
keybind = herdr-agents/physical:three=text:\x02\x1b[51;7u
keybind = herdr-agents/physical:four=text:\x02\x1b[52;7u
keybind = herdr-agents/physical:five=text:\x02\x1b[53;7u
keybind = herdr-agents/physical:six=text:\x02\x1b[54;7u
keybind = herdr-agents/physical:seven=text:\x02\x1b[55;7u
keybind = herdr-agents/physical:eight=text:\x02\x1b[56;7u
keybind = herdr-agents/physical:nine=text:\x02\x1b[57;7u
keybind = herdr-agents/escape=deactivate_key_table
keybind = herdr-agents/enter=deactivate_key_table
keybind = herdr-agents/unconsumed:catch_all=deactivate_key_table

# One-shot interactive-shell actions. Cancel Herdr's prefix before forwarding
# a private Kitty transport chord to the local or remote Pi overlay.
keybind = herdr-shell/f=text:\x1b[102;7u
keybind = herdr-shell/b=text:\x1b[98;7u
keybind = herdr-shell/t=text:\x1b[116;7u
keybind = herdr-shell/m=text:\x1b[109;7u
keybind = herdr-shell/g=text:\x1b[103;7u
keybind = herdr-shell/p=text:\x1b[112;7u
keybind = herdr-shell/escape=end_key_sequence
keybind = herdr-shell/unconsumed:catch_all=end_key_sequence
